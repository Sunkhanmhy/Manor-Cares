# Copy this file to .env for local development: cp .env.example .env
# .env is git-ignored and MUST NOT be committed. In production, set these
# as real environment variables in your host's dashboard instead (Railway,
# Vercel, Render, etc.).

# --- Database (Supabase — Project Settings → Database → Connection string) ---
# Use the "Transaction pooler" URI for most hosts (port 6543); the direct
# connection URI (port 5432) also works. DATABASE_URL is accepted as an alias.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
PGSSLMODE=require

# --- Supabase project API (Project Settings → API) ---
# Used for OAuth sign-in (php/oauth-start.php / php/oauth-callback.php).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# --- Auth (this app's own JWT session, issued after password OR OAuth sign-in) ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace-with-a-64-char-random-hex-secret
JWT_TTL_SECONDS=86400
BCRYPT_COST=12

# --- Webhooks (payment provider webhooks — see php/webhook.php) ---
WEBHOOK_SECRET=replace-with-a-strong-random-secret
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-endpoint-signing-secret

# --- Mail (contact form) — see php/mail-config.php + php/mailer.php ---
# Preferred: Resend (https://resend.com/api-keys). Leave blank to fall back to SMTP below.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# Fallback: SMTP via PHPMailer, used only when RESEND_API_KEY is blank.
MAIL_USE_SMTP=true
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@manor-cares.com
MAIL_FROM_NAME=Manor Cares Website
MAIL_TO_ADDRESS=support@manor-cares.com
MAIL_TO_NAME=Manor Cares Support
ALLOWED_ORIGIN=

