# Copy this file to .env for local development: cp .env.example .env
# .env is git-ignored and MUST NOT be committed. On Railway, set these as
# real environment variables in the service's Variables tab instead.

# --- Database (matches docker-compose.yml defaults) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=manor_cares
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable

# --- Auth ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace-with-a-64-char-random-hex-secret
JWT_TTL_SECONDS=86400
BCRYPT_COST=12

# --- Webhooks ---
WEBHOOK_SECRET=replace-with-a-strong-random-secret

# --- Mail (contact form / PHPMailer) — see php/mail-config.php ---
MAIL_USE_SMTP=true
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@manor-cares.com
MAIL_FROM_NAME=Manor Cares Website
MAIL_TO_ADDRESS=support@manor-cares.com
MAIL_TO_NAME=Manor Cares Support
ALLOWED_ORIGIN=
