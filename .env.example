# Copy this file to .env for local development: cp .env.example .env
# .env is git-ignored and MUST NOT be committed. In production, set these
# as real environment variables in your host's dashboard instead.



# --- Database (Supabase — Project Settings → Database → Connection string) ---
# TODO: paste your real Supabase connection string here once the project exists.
# IMPORTANT: Supabase's dashboard shows the password as a bracketed
# placeholder, e.g. postgresql://postgres:[YOUR-PASSWORD]@host:port/postgres —
# replace the ENTIRE "[YOUR-PASSWORD]" segment including the brackets with
# your real password. Leaving the brackets in place causes every DB
# connection (signup/login/everything) to fail with an auth error.
SUPABASE_DB_URL=""
PGSSLMODE=""


# --- Supabase project API (Project Settings → API) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWKS_URL=""


# --- Auth ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=""
JWT_TTL_SECONDS=""
BCRYPT_COST=""  



# --- Webhooks ---
WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET=""


# --- Mail (contact form) — see php/mail-config.php + php/mailer.php ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""


MAIL_USE_SMTP=""
MAIL_SMTP_HOST=""
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
MAIL_SMTP_PORT=""
MAIL_SMTP_ENCRYPTION=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=""
MAIL_TO_ADDRESS=""
MAIL_TO_NAME=""
ALLOWED_ORIGIN=